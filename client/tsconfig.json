{
  "include": ["./src"],
  "compilerOptions": {
    "incremental": true,
    "target": "es6",
    "module": "node16",
    "outDir": "dist",
    "rootDir": "./src",
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react"]
  }
}
